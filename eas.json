{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "channel": "production"
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "environment": "preview",
      "channel": "paracloudbuild"
    }
  }
}

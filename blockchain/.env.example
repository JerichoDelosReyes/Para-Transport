# THIS IS AN EXAMPLE FILE — DO NOT PUT REAL KEYS HERE
# Copy this file to .env and fill in your real values there

# Deployer wallet private key (KEEP SECRET — NEVER COMMIT THIS)
# This is Para's treasury wallet that pays gas fees
DEPLOYER_PRIVATE_KEY=09f5edd64a35142c240a9443f4941ef1fa27ed453c624102b605fb61626b76f5

# RPC URLs
POLYGON_AMOY_RPC_URL=https://rpc.ankr.com/polygon_amoy
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# Contract addresses (filled after running deploy.js)
PARA_TOKEN_CONTRACT_ADDRESS=
PARA_BADGE_CONTRACT_ADDRESS=

# PolygonScan API key (for contract verification — get free at polygonscan.com)
POLYGONSCAN_API_KEY=2RHPA25U7F7QABRSNKQRNCBI6QKXMAYHUQ

{
  "expo": {
    "name": "Para",
    "slug": "para-transport-test",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "para",
    "icon": "./assets/logo/appicon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8A020"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Para uses your location to find your current position and show routes to your destination.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Para needs access to speech recognition to let you search for routes using your voice.",
        "NSMicrophoneUsageDescription": "Para needs access to the microphone to convert your speech into text searches."
      },
      "bundleIdentifier": "com.noxencv.paratransport"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo/appicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.noxencv.paratransport"
    },
    "web": {
      "favicon": "./assets/logo/appicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-speech-recognition",
      "expo-font",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "64f895f4-ffe8-474c-8180-5711e44e81b4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/64f895f4-ffe8-474c-8180-5711e44e81b4"
    }
  }
}
